# Copy to .env and fill in values
# Local dev: matches infra/docker-compose.yml defaults

DATABASE_URL=postgresql+asyncpg://flood:flood@localhost:5432/flooddb
DATABASE_SYNC_URL=postgresql+psycopg2://flood:flood@localhost:5432/flooddb
DATABASE_TEST_URL=postgresql+psycopg2://flood:flood@localhost:5433/flooddb_test

REDIS_URL=redis://localhost:6379

# SePay bank-transfer monitor (FIR-81)
# Dashboard: https://sepay.vn → Webhook → HMAC-SHA256 Secret Key
SEPAY_API_KEY=
# Bank account SePay monitors for incoming transfers
SEPAY_ACCOUNT_NUMBER=
# Bank code for VietQR URL (e.g. 970436 = Vietcombank, 970422 = MB Bank)
SEPAY_BANK_CODE=
# Must match prefix in SePay dashboard: Company → General settings → Payment code structure
SEPAY_PAYMENT_CODE_PREFIX=FLOOD

# Required for --source news/all (FIR-27 scraper uses claude-haiku-4-5-20251001)
# Get key: https://console.anthropic.com/ | Cost: ~$0.001 per article processed
# Skip LLM calls during local dev / CI: set FLOOD_SCRAPER_MOCK_LLM=1 instead
ANTHROPIC_API_KEY=

# Set to 1 to skip real Haiku API calls in the news scraper (safe for CI, local dev)
# Returns a fixed Hanoi flood fixture so the full insert pipeline can still be tested
FLOOD_SCRAPER_MOCK_LLM=

INTERNAL_CRON_KEY=changeme

EMAIL_SMTP_HOST=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
